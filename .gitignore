# Gehalten in Deckung mit data_wizard/.gitignore und IB-Tool-3/.gitignore.

# === IDE ===
.idea/
.vscode/
*.iws
*.iml
*.ipr

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
.eggs/

# === Virtual Environments ===
venv/
.venv/
env/

# === Environment & Secrets ===
.env
.env.*

# === Logs ===
logs/
*.log

# === OS ===
.DS_Store
Thumbs.db
Desktop.ini
nul

# === Test / Coverage Artefakte ===
test/__pycache__/
test/logs/
test/*.gpkg
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Sidecar-Dateien, die QGIS/GDAL beim Lesen von Shapefiles selbst anlegt.
*.qix
*.shp.xml

# Ablage fuer aussortierte Dateien, die noch nicht geloescht wurden.
_to_delete/

# === QGIS Plugin generierte Dateien ===
# Kompilierte Übersetzungen (*.qm) sind Build-Artefakte aus i18n/*.ts.
# resources.py wird bewusst NICHT ignoriert.
*.qm

# === Build-Artefakte ===
dist/

# === Claude Code (lokale Einstellungen, nicht committen) ===
/.claude/settings.local.json
/.claude/settings.json
